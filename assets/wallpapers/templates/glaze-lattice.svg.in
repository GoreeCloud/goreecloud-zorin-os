<svg xmlns="http://www.w3.org/2000/svg" width="3840" height="2160" viewBox="0 0 3840 2160" role="img" aria-labelledby="title desc">
  <title id="title">Glaze UI Facet Lattice {{mode_label}}</title>
  <desc id="desc">Glaze UI wallpaper preserving the official Facet mark while surrounding it with an ordered lattice of translucent interface planes derived from the Glaze presentation language.</desc>
  <defs>
    <linearGradient id="wpGlazeLatBg" x1="0" y1="0" x2="0" y2="1"><stop stop-color="{{canvas}}"/><stop offset="1" stop-color="{{deep}}"/></linearGradient>
    <linearGradient id="wpGlazeLine" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#2DD4BF" stop-opacity="0.14"/><stop offset="0.5" stop-color="#38BDF8" stop-opacity="0.28"/><stop offset="1" stop-color="#6366F1" stop-opacity="0.14"/></linearGradient>
  </defs>
  <rect width="3840" height="2160" fill="url(#wpGlazeLatBg)"/>
  <g fill="none" stroke="url(#wpGlazeLine)" stroke-width="4">
    <rect x="260" y="310" width="720" height="720" rx="180"/><rect x="650" y="760" width="820" height="820" rx="205"/>
    <rect x="1320" y="330" width="940" height="940" rx="235"/><rect x="2190" y="760" width="820" height="820" rx="205"/>
    <rect x="2840" y="340" width="700" height="700" rx="175"/>
  </g>
  <g fill="{{surface}}" opacity="0.22">
    <rect x="350" y="400" width="520" height="520" rx="130"/><rect x="2320" y="890" width="560" height="560" rx="140"/><rect x="2940" y="440" width="500" height="500" rx="125"/>
  </g>
  <rect x="1300" y="430" width="1240" height="1240" rx="280" fill="{{surface}}" opacity="0.30" stroke="#60A5FA" stroke-opacity="0.24" stroke-width="4"/>
  <svg x="1380" y="510" width="1080" height="1080" viewBox="{{identity_viewbox}}" aria-hidden="true">
{{identity_inner}}
  </svg>
  <path d="M0 2050H3840V2160H0Z" fill="{{elevated}}" opacity="0.62"/>
</svg>
