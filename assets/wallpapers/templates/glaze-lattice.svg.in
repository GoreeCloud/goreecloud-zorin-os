<svg xmlns="http://www.w3.org/2000/svg" width="3840" height="2160" viewBox="0 0 3840 2160" role="img" aria-labelledby="title desc">
  <title id="title">Glaze Lattice {{mode_label}}</title>
  <desc id="desc">Glaze UI supporting wallpaper with optically balanced rounded lattice geometry and restrained atmospheric color.</desc>
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1"><stop stop-color="{{canvas}}"/><stop offset="1" stop-color="{{deep}}"/></linearGradient>
    <radialGradient id="teal" cx="0.77" cy="0.22" r="0.58"><stop stop-color="{{accent2}}" stop-opacity="0.26"/><stop offset="1" stop-color="{{accent}}" stop-opacity="0"/></radialGradient>
    <radialGradient id="amber" cx="0.13" cy="0.12" r="0.40"><stop stop-color="{{amber}}" stop-opacity="0.17"/><stop offset="1" stop-color="{{amber}}" stop-opacity="0"/></radialGradient>
  </defs>
  <rect width="3840" height="2160" fill="url(#bg)"/><rect width="3840" height="2160" fill="url(#teal)"/><rect width="3840" height="2160" fill="url(#amber)"/>
  <g fill="none" stroke="{{soft}}" stroke-opacity="0.13" stroke-width="3">
    <rect x="520" y="450" width="620" height="620" rx="150"/><rect x="1020" y="680" width="720" height="720" rx="180"/>
    <rect x="1610" y="390" width="860" height="860" rx="215"/><rect x="2360" y="710" width="700" height="700" rx="175"/>
    <rect x="2850" y="390" width="520" height="520" rx="130"/>
  </g>
  <g fill="{{surface}}" opacity="0.16">
    <circle cx="910" cy="1540" r="220"/><circle cx="2700" cy="1490" r="300"/><circle cx="2020" cy="1730" r="140"/>
  </g>
  <path d="M0 2010H3840V2160H0Z" fill="{{elevated}}" opacity="0.65"/>
</svg>
